{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/wiki/wiki.py\" hook",
            "timeout": 30,
            "statusMessage": "Checking changed Lounge wiki pages"
          }
        ]
      }
    ]
  }
}
